<?xml version="1.0" encoding="utf-8"?>
<!--
  考试倒计时小组件布局。
  只允许 RemoteViews 认识的基础控件（LinearLayout / FrameLayout / TextView / ImageView / Button …）。
  裸 View 不在白名单里，lint 会以 RemoteViewLayout 报错、真机上更会直接 inflate 失败，所以分隔线也用 TextView。
  颜色全部写死——RemoteViews 在桌面上拿不到 App 主题，主题属性在这里不可靠；
  深蓝实色底（@drawable/widget_background，#FF1F2933）+ 白字，和第一个小组件是同一套观感。

  高度按 widget_countdown_info.xml 的 minHeight=110dp 排过账，各语言文案都不会被截断：
  12 + 22(标题行 / 切换胶囊) + 5 + 1(分隔线) + 8 + 28(24sp 天数) + 3 + 14(日期行) + 12 = 105dp。
  点击事件由 CountdownWidgetProvider 挂：widget_countdown_root 打开 App，
  widget_countdown_switch 是「切换下一场」的热区（各挂各的 PendingIntent）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_countdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- 标题行：小组件名 + 「切换」热区 -->
    <LinearLayout
        android:id="@+id/widget_countdown_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_countdown_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_countdown_title"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!--
          「切换」热区：小胶囊，底色沿用同一张圆角 drawable，文字用强调色，浅色 / 深色壁纸上都点得明白。
          只有一场考试时由 Provider 把它 setViewVisibility(GONE) 藏起来。
        -->
        <TextView
            android:id="@+id/widget_countdown_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_background"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_countdown_switch"
            android:textColor="#FFFFB4A2"
            android:textSize="11sp" />
    </LinearLayout>

    <!--
      分隔线：纯色 1dp，任何壁纸上都看得见。
      注意这里**不能**用裸 <View>：RemoteViews 只认一个控件白名单
      （LinearLayout / FrameLayout / TextView / ImageView / Button …），裸 View 不在里面，
      真机上 inflate 会直接失败、小组件一片空白。用空的 TextView 顶替，效果一样。
    -->
    <TextView
        android:id="@+id/widget_countdown_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:background="#4DFFFFFF" />

    <!-- 考试名（左，可省略号）+ 天数（右，大号强调色） -->
    <LinearLayout
        android:id="@+id/widget_countdown_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_countdown_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_countdown_empty"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_countdown_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_countdown_days_placeholder"
            android:textColor="#FFFFB4A2"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 日期 · 课程 · 地点（空的部分运行时会省掉） -->
    <TextView
        android:id="@+id/widget_countdown_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_countdown_meta_placeholder"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
