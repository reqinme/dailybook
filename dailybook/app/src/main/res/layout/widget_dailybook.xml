<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件布局：只允许 RemoteViews 认识的基础控件（LinearLayout / FrameLayout / TextView / ImageView / Button …）。
  裸 View 不在白名单里，lint 会以 RemoteViewLayout 报错、真机上更会直接 inflate 失败，所以分隔线也用 TextView。
  颜色全部写死——RemoteViews 在桌面上拿不到 App 主题，主题属性在这里不可靠；
  深蓝实色底 + 白字，在浅色 / 深色壁纸上都一样清楚。

  高度按 widget_info.xml 的 minHeight=110dp 排过账，各语言文案都不会被截断：
  12 + 17(标题) + 5 + 1 + 7 + 31(两列收支) + 6 + 15(待办/专注) + 12 = 106dp。
  点击事件由 WidgetProvider 用 setOnClickPendingIntent 挂在 widget_root 上。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- 标题行：应用名（@string/app_name 四语已本地化） -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!--
      分隔线：纯色 1dp，任何壁纸上都看得见。
      注意这里**不能**用裸 <View>：RemoteViews 只认一个控件白名单
      （LinearLayout / FrameLayout / TextView / ImageView / Button …），裸 View 不在里面，
      真机上 inflate 会直接失败、小组件一片空白。用空的 TextView 顶替，效果一样。
    -->
    <TextView
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:background="#4DFFFFFF" />

    <!-- 两列：今日支出 / 今日收入 -->
    <LinearLayout
        android:id="@+id/widget_figures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_expense_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_expense_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_today_expense"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_expense_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_money_placeholder"
                android:textColor="#FFFFB4A2"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_income_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_income_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_today_income"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_income_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_money_placeholder"
                android:textColor="#FF8BD9A8"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 待办剩余 / 今日专注分钟 -->
    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_todo_focus_placeholder"
        android:textColor="#E6FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
