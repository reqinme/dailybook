<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">日常本</string>
    <string name="shortcut_add_tx_short">記録する</string>
    <string name="shortcut_add_tx_long">家計簿を開いて収支を記録</string>
    <string name="shortcut_add_todo_short">ToDo を追加</string>
    <string name="shortcut_add_todo_long">ToDo リストを開いて追加</string>
    <string name="shortcut_focus_short">集中を開始</string>
    <string name="shortcut_focus_long">タイマーを開いて集中を始める</string>

    <!-- ホーム画面ウィジェット：文字は**システム**の言語に従います（システム UI のため、アプリ内の言語設定は効きません） -->
    <string name="widget_today_expense">今日の支出</string>
    <string name="widget_today_income">今日の収入</string>
    <!-- %1$s = ¥ 付きの金額 -->
    <string name="widget_money">¥%1$s</string>
    <!-- %1$d = 未完了の ToDo 数、%2$d = 今日の集中（分） -->
    <string name="widget_todo_focus">ToDo %1$d · 集中 %2$d 分</string>
    <!-- レイアウト内のプレースホルダー。実行時に実際の数値へ置き換わります -->
    <string name="widget_money_placeholder">¥0.00</string>
    <string name="widget_todo_focus_placeholder">ToDo 0 · 集中 0 分</string>

    <!-- 試験カウントダウンウィジェット：文字は同じく**システム**の言語に従います -->
    <!-- 4×2 マスは幅 180dp しかないため、全角の長い見出しは省略記号で切られます。短い見出しにしています -->
    <string name="widget_countdown_title">試験まで</string>
    <!-- %1$d = 残りの日数 -->
    <string name="widget_countdown_days">%1$d 日</string>
    <string name="widget_countdown_today">今日</string>
    <string name="widget_countdown_passed">終了</string>
    <!-- ホットスポット：次の試験に切り替え -->
    <string name="widget_countdown_switch">切替</string>
    <!-- 今後の試験が 1 件もないときの案内（上段 / 下段） -->
    <string name="widget_countdown_empty">試験がありません</string>
    <string name="widget_countdown_empty_hint">タップして追加</string>
    <!-- レイアウト内のプレースホルダー。実行時に実際のデータへ置き換わります -->
    <string name="widget_countdown_days_placeholder">30 日</string>
    <string name="widget_countdown_meta_placeholder">9月13日 · データ構造 · 教三101</string>
</resources>
